{
  "name": "@nuvriqo/ui",
  "version": "0.3.0",
  "description": "Shared look, layout and components for Nuvriqo Forge apps (Atlassian-token based, dark-mode ready).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./css": "./dist/nuvriqo-ui.css",
