    "./html": "./src/js/html.js",
    "./react": "./src/react/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "nuvriqo-ui-copy": "bin/nuvriqo-ui-copy.mjs",
    "nuvriqo-ui-check": "bin/nuvriqo-ui-check.mjs",
